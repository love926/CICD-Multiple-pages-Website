pipeline{
    agent any
    stages{
        stage('Code'){
            steps{
                echo 'Code upload Successfully'
                git url:"https://github.com/love926/CICD-Multiple-pages-Website.git",branch:"master"
            }
        }
         stage('Build'){
            steps{
                echo 'Code Build Successfully'
                sh 'docker build -t coffee:latest .'
            }
        }
         stage('Test'){
            steps{
                echo 'Code Test Successfully'
            }
        }
         stage('Deploy'){
            steps{
                echo 'Code Deploy Successfully'
                sh 'docker run -d -p 82:80 coffee:latest'
            }
        }
    }
}
